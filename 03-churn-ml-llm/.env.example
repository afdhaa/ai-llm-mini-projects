# ==============================================================================
# AI PROVIDER SETTINGS
# ==============================================================================
# Provider options: gemini (default) | openai | anthropic | custom
AI_PROVIDER=gemini

# Model name (optional, defaults to standard model per provider)
# AI_MODEL=gemini-2.5-flash         # default for gemini
# AI_MODEL=gpt-4o-mini              # default for openai
# AI_MODEL=claude-3-5-haiku-latest  # default for anthropic
# AI_MODEL=llama3.1                 # default for custom

# ==============================================================================
# API KEYS (Set the key for your active provider)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# CUSTOM / OPENAI-COMPATIBLE ENDPOINTS (Ollama, Groq, DeepSeek, vLLM, Z.ai)
# ==============================================================================
# Used when AI_PROVIDER=custom:
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=dummy-key

# Example Z.ai Coding Plan:
# AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# AI_MODEL=glm-5.3
# AI_API_KEY=your_key_here
